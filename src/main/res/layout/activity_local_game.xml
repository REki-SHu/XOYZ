<?xml version="1.0" encoding="utf-8"?>
<!--
    Local game screen layout.
    A FrameLayout that hosts:
      - The 3D rendering surface (Phase 2: LibGDX GLSurfaceView / SurfaceView)
      - An overlay HUD showing the current player and their symbols
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!--
        Phase 2: Replace this placeholder with a LibGDX AndroidFragmentApplication
        or a raw android.opengl.GLSurfaceView.
    -->
    <View
        android:id="@+id/game_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD overlay at the top of the screen -->
    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#80000000"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_current_player"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Player 1's turn"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_symbols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X / Y"
            android:textColor="@color/player1_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>