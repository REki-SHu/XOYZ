<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/background_dark"
              android:padding="12dp">

    <!-- Turn indicator -->
    <TextView
            android:id="@+id/tvTurnIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Player 1's turn  (X / Y)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    <!-- Layer tabs -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

        <Button
                android:id="@+id/btnLayer0"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Top"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

        <Button
                android:id="@+id/btnLayer1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Middle"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

        <Button
                android:id="@+id/btnLayer2"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Bottom"
                android:textSize="13sp" />

    </LinearLayout>

    <!-- Layer 0 (Top) -->
    <GridLayout
            android:id="@+id/gridLayer0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:rowCount="3"
            android:columnCount="3"
            android:visibility="visible">

        <Button android:id="@+id/cell_0_0_0" style="@style/CellButton" android:layout_row="0" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_0_1" style="@style/CellButton" android:layout_row="0" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_0_2" style="@style/CellButton" android:layout_row="0" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_1_0" style="@style/CellButton" android:layout_row="1" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_1_1" style="@style/CellButton" android:layout_row="1" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_1_2" style="@style/CellButton" android:layout_row="1" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_2_0" style="@style/CellButton" android:layout_row="2" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_2_1" style="@style/CellButton" android:layout_row="2" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_0_2_2" style="@style/CellButton" android:layout_row="2" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />

    </GridLayout>

    <!-- Layer 1 (Middle) -->
    <GridLayout
            android:id="@+id/gridLayer1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:rowCount="3"
            android:columnCount="3"
            android:visibility="gone">

        <Button android:id="@+id/cell_1_0_0" style="@style/CellButton" android:layout_row="0" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_0_1" style="@style/CellButton" android:layout_row="0" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_0_2" style="@style/CellButton" android:layout_row="0" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_1_0" style="@style/CellButton" android:layout_row="1" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_1_1" style="@style/CellButton" android:layout_row="1" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_1_2" style="@style/CellButton" android:layout_row="1" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_2_0" style="@style/CellButton" android:layout_row="2" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_2_1" style="@style/CellButton" android:layout_row="2" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_1_2_2" style="@style/CellButton" android:layout_row="2" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />

    </GridLayout>

    <!-- Layer 2 (Bottom) -->
    <GridLayout
            android:id="@+id/gridLayer2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:rowCount="3"
            android:columnCount="3"
            android:visibility="gone">

        <Button android:id="@+id/cell_2_0_0" style="@style/CellButton" android:layout_row="0" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_0_1" style="@style/CellButton" android:layout_row="0" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_0_2" style="@style/CellButton" android:layout_row="0" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_1_0" style="@style/CellButton" android:layout_row="1" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_1_1" style="@style/CellButton" android:layout_row="1" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_1_2" style="@style/CellButton" android:layout_row="1" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_2_0" style="@style/CellButton" android:layout_row="2" android:layout_column="0" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_2_1" style="@style/CellButton" android:layout_row="2" android:layout_column="1" android:layout_rowWeight="1" android:layout_columnWeight="1" />
        <Button android:id="@+id/cell_2_2_2" style="@style/CellButton" android:layout_row="2" android:layout_column="2" android:layout_rowWeight="1" android:layout_columnWeight="1" />

    </GridLayout>

</LinearLayout>